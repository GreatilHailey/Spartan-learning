          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9NCbLemoYoQnP5xcXKbQ-7" value="用于实现&lt;div&gt;对计算结构作出承诺&lt;div&gt;帮助降低后续验证成本&lt;/div&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;" parent="9NCbLemoYoQnP5xcXKbQ-6" connectable="0" vertex="1">
